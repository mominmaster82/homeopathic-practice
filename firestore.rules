rules_version = '2';

// একক-অ্যাডমিন অ্যাপ: শুধুমাত্র লগইন-করা (Firebase Auth) ব্যবহারকারী
// Firestore পড়তে/লিখতে পারবেন। অলগিন অবস্থায় সব অ্যাক্সেস বন্ধ।
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
