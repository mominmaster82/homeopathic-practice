rules_version = '2';

// ভূমিকা (users/{uid} ডকুমেন্টে role + status):
//   super_admin → সব ডেটা পড়া/লেখা; মেয়াদসীমা নেই; রোগী, কেস, প্রেসক্রিপশন, কাউন্টার, ইউজার ব্যবস্থাপনা
//   subscriber  → শুধু রেফারেন্স (রেপার্টরি/ম্যাটেরিয়া) পড়া; expires_at টাইমস্ট্যাম্প ভবিষ্যতে থাকতে হবে
// status != 'active' হলে (pending/suspended) বা সাবস্ক্রিপশনের মেয়াদ শেষ হলে কিছুই পড়া/লেখা যায় না।
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && profile().status == 'active'
        && (
          profile().role == 'super_admin'
          || (
            profile().role == 'subscriber'
            && profile().get('expires_at', null) is timestamp
            && profile().get('expires_at', null) > request.time
          )
        );
    }

    function adminUser() {
      return activeUser() && profile().role == 'super_admin';
    }

    // নিজের প্রোফাইল পড়া যায়; তালিকা/তৈরি/পরিবর্তন শুধু অ্যাডমিন
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if adminUser();
    }

    // রেফারেন্স ডেটা — সক্রিয় ইউজার পড়বে, শুধু অ্যাডমিন লিখবে
    match /remedies/{id} {
      allow read: if activeUser();
      allow write: if adminUser();
    }
    match /rubrics/{id} {
      allow read: if activeUser();
      allow write: if adminUser();
    }
    match /rubric_links/{id} {
      allow read: if activeUser();
      allow write: if adminUser();
    }
    match /settings/{id} {
      allow read: if activeUser();
      allow write: if adminUser();
    }

    // রোগীর গোপনীয় ডেটা — সম্পূর্ণ অ্যাডমিন-সীমিত
    match /patients/{id} {
      allow read, write: if adminUser();
    }
    match /cases/{id} {
      allow read, write: if adminUser();
    }
    match /prescriptions/{id} {
      allow read, write: if adminUser();
    }
    match /counters/{id} {
      allow read, write: if adminUser();
    }

    // অজানা যেকোনো কালেকশন ডিফল্টভাবে বন্ধ
  }
}
